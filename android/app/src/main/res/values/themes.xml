<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shelf draws its own dark and light themes; MIUI's forced dark mode would invert its
         dark-on-light details (tape labels, sleeves), so it's turned off. -->
    <style name="Theme.Shelf" parent="android:Theme.Material.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@color/tray</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
